# ==========================================
# INTELLIOPS GLOBAL ENVIRONMENT CONFIGURATION
# ==========================================

# Environment
NODE_ENV=development
APP_ENV=local

# ------------------------------------------
# DATABASE (PostgreSQL 16 + pgvector)
# ------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intelliops
POSTGRES_USER=intelliops_user
POSTGRES_PASSWORD=intelliops_secure_password
DATABASE_URL=postgresql://intelliops_user:intelliops_secure_password@localhost:5432/intelliops

# ------------------------------------------
# REDIS (Cache & PubSub)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ------------------------------------------
# KAFKA (Event Streaming)
# ------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=intelliops-cluster
KAFKA_GROUP_ID=intelliops-core

# ------------------------------------------
# SPRING BOOT CORE SERVICE (Port 8080)
# ------------------------------------------
CORE_SERVICE_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ------------------------------------------
# FASTAPI AI SERVICE (Port 8000)
# ------------------------------------------
AI_SERVICE_PORT=8000
OPENAI_API_KEY=sk-placeholder-replace-with-your-real-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
SIMULATE_AI_WHEN_NO_KEY=true

# ------------------------------------------
# REALTIME SERVICE (Port 4000)
# ------------------------------------------
REALTIME_SERVICE_PORT=4000
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------
# NEXT.JS WEB APP (Port 3000)
# ------------------------------------------
NEXT_PUBLIC_CORE_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_AI_API_URL=http://localhost:8000/api/v1/ai
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXTAUTH_SECRET=supersecretnextauthsessionsecretkey123456789
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------
# KEYCLOAK (OIDC Provider)
# ------------------------------------------
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=intelliops
KEYCLOAK_CLIENT_ID=intelliops-web
KEYCLOAK_CLIENT_SECRET=intelliops-client-secret-12345
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ------------------------------------------
# OBJECT STORAGE (MinIO / S3)
# ------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=intelliops-documents
